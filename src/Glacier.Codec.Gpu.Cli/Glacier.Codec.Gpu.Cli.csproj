<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Glacier.Codec.Gpu.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>High-performance GPU cryptographic hashing and parallel nonce search CLI worker for Glacier.Codec.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glacier.Codec\Glacier.Codec.csproj" />
    <ProjectReference Include="..\Glacier.Codec.Gpu\Glacier.Codec.Gpu.csproj" />
  </ItemGroup>
</Project>
